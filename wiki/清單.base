filters:
  and:
    - file.inFolder("wiki")
    - file.ext == "md"
    - file.name != "01.index"
properties:
  description:
    displayName: 摘要
  tags:
    displayName: 主題
  file.name:
    displayName: 候選頁
views:
  - type: table
    name: wiki 候選清單
    order:
      - file.name
      - description
      - tags
    sort:
      - property: file.name
        direction: ASC
