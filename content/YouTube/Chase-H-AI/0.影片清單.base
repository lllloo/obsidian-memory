filters:
  and:
    - file.inFolder("YouTube/Chase-H-AI")
    - file.ext == "md"
properties:
  source:
    displayName: 連結
  created:
    displayName: 日期
  file.name:
    displayName: 筆記
views:
  - type: table
    name: 影片清單
    groupBy:
      property: created
      direction: DESC
    order:
      - file.name
      - source
      - created
    sort:
      - property: file.name
        direction: ASC
