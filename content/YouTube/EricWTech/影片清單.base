filters:
  and:
    - file.inFolder("YouTube/EricWTech")
    - file.ext == "md"
properties:
  status:
    displayName: 狀態
  published:
    displayName: 上傳日期
  source:
    displayName: 連結
  file.name:
    displayName: 筆記
views:
  - type: table
    name: 影片清單
    order:
      - file.name
      - status
      - published
      - source
    sort:
      - property: published
        direction: DESC
